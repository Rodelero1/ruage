#!/bin/sh
# Refuse to commit the game's data or anything derived from it. See docs/licensing.md.
set -e

staged=$(git diff --cached --name-only)
bad=$(printf '%s\n' "$staged" | grep -E \
  '^(Age2HD/|build/|config/gamedata/|config/MANIFEST\.toml)|\.(aoe2spgame|aoe2record|mgz|mgx|slp|drs|wav|mp3|bina|dat)$' \
  || true)

if [ -n "$bad" ]; then
    echo "REFUSED: staged paths contain game data or extracted values:" >&2
    printf '%s\n' "$bad" | sed 's/^/  /' >&2
    echo "" >&2
    echo "These are regenerable from the user's own install; they must not be redistributed." >&2
    echo "Policy: docs/licensing.md.  Unstage with: git restore --staged <path>" >&2
    exit 1
fi

# The review gate (AGENTS.md): a change to engine, content or tooling must carry its adversarial review, staged with it.
# This is the one rule that kept being stated and skipped, so it is checked rather than remembered.
if ! python3 tools/review_check.py; then
    exit 1
fi

# The one open step (D193): a next-step file that has grown into a second log is not a next step, and every session pays for it.
if ! python3 tools/next_step.py --check >/dev/null; then
    python3 tools/next_step.py --check >&2
    exit 1
fi

exit 0
